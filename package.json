{
  "name": "omp-trainer",
  "version": "0.9.0",
  "description": "Readable startup and per-prompt hints and on-demand recall for registered OMP skills and commands.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-trainer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint . --max-warnings 0",
    "release:check": "npm run lint && npm test",
    "reinstall": "omp plugin install github:klondikemarlen/omp-trainer"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "CHANGELOG.md"
  ],
  "omp": {
    "extensions": [
      "./index.js"
    ]
  },
  "keywords": [
    "omp-plugin",
    "coaching"
  ],
  "dependencies": {
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}
