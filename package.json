{
  "name": "omp-trainer",
  "version": "0.8.0",
  "description": "Readable per-prompt hints and on-demand recall for registered OMP skills and commands.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-trainer.git"
  },
  "engines": {
